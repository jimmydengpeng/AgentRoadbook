    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1",
    "yaml": "^2.8.1",
    "zod": "3.24.2"
  },
  "pnpm": {
